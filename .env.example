# PostgreSQL çalışma zamanı bağlantısı (sunucusuz sağlayıcılarda pooled URL kullanın).
DATABASE_URL="postgresql://vefa:change-me@localhost:5432/vefa"

# Migration için doğrudan bağlantı gerekiyorsa DATABASE_URL yerine bunu
# prisma.config.ts içinde seçebilirsiniz.
DIRECT_URL=""

# En az 32 baytlık rastgele bir değer kullanın.
SESSION_SECRET="change-this-with-a-long-random-secret"

# Yalnızca yerel verileri dışa aktarmak/geçişi denemek için kullanılmalıdır.
# Üretimde true yapmayın.
NEXT_PUBLIC_USE_LOCAL_API="false"

# Gerçek sağlayıcı yapılandırılmadığında gönderimler PENDING/FAILED kalır.
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
NETGSM_HEADER=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
